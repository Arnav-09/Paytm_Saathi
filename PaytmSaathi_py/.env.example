# ---------------------------------------------------------------------------
# AI model. Free option: Groq (no credit card) - create a key at https://console.groq.com/keys
# ---------------------------------------------------------------------------
LLM_PROVIDER=groq            # groq | gemini | openai | ollama | mock (offline demo)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Alternative free option: Google Gemini - key at https://aistudio.google.com/apikey
# LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Any other OpenAI-compatible API (LLM_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Local Ollama (LLM_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Secret used to sign API login tokens - set any long random string
APP_SECRET=change-me-to-a-long-random-string

# Optional tuning
# OCR_DPI=200
# OCR_LANGS=eng+hin      # only for the pytesseract backend

